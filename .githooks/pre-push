#!/bin/sh
# Trava do push: nada sai deste repositório sem a varredura de privacidade zerada (ferramentas/varredura.mjs).
# Ligar uma vez por clone: git config core.hooksPath .githooks  (o publicar.mjs liga sozinho)
RAIZ="$(git rev-parse --show-toplevel)"
exec node "$RAIZ/ferramentas/varredura.mjs" --pre-push
